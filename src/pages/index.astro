---
import Layout from '../layouts/Layout.astro';

const name = 'Mark Ryan Zipagan';
const position = 'AI Engineer';
---

<Layout name={name} position={position}>
	<main>
		<h1 class="text-red-700">{name} | {position}</h1>
	</main>
</Layout>

<style>
	main {
		padding: 1rem;
	}

	.text-red-700 {
		color: #b91c1c;
	}
</style>
